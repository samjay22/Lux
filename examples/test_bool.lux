// Test boolean return values in JIT

fn is_even(n: int) -> bool {
    if n % 2 == 0 {
        return true
    }
    return false
}

fn test_int(n: int) -> int {
    if n % 2 == 0 {
        return 1
    }
    return 0
}

print("Testing boolean returns:\n")

print("is_even(2) = ")
print(to_string(is_even(2)))
print("\n")

print("is_even(3) = ")
print(to_string(is_even(3)))
print("\n")

print("test_int(2) = ")
print(to_string(test_int(2)))
print("\n")

print("test_int(3) = ")
print(to_string(test_int(3)))
print("\n")

// Test in if statement
if is_even(2) {
    print("2 is even (correct)\n")
} else {
    print("2 is odd (WRONG!)\n")
}

if is_even(3) {
    print("3 is even (WRONG!)\n")
} else {
    print("3 is odd (correct)\n")
}

